FROM mysql:8.0

ARG MYSQL_HOST
ARG MYSQL_PORT
ARG MYSQL_USER
ARG MYSQL_PASSWORD
ARG MYSQL_COMMAND

ENV MYSQL_HOST=$MYSQL_HOST \
    MYSQL_PORT=$MYSQL_PORT \
    MYSQL_USER=$MYSQL_USER \
    MYSQL_PASSWORD=$MYSQL_PASSWORD \
    MYSQL_COMMAND=$MYSQL_COMMAND

ENTRYPOINT sh -c 'mysql -h "$MYSQL_HOST" -P "$MYSQL_PORT" -u "$MYSQL_USER" -p"$MYSQL_PASSWORD" -A -e "$MYSQL_COMMAND"'
